[Unit]
Description=Watch vault plans for approved-*.plan.md and implement via PR
After=network-online.target

[Service]
Type=simple
# Runs as a dedicated non-root user: `claude -p` below needs
# --allow-dangerously-skip-permissions to edit files non-interactively, and
# Claude Code refuses that flag when running as root (see docs/setup.md).
# All three units share this user so `claude auth`/`gh auth` only need
# doing once. Create the user and its vault ACL before enabling this unit.
User=mcw
Environment=HOME=/home/mcw
Environment=VAULT_PATH=/vault
Environment=PROJECTS_DIR=/home/mcw/projects
# EDIT before starting: set your own ntfy topic (see docs/notifications.md)
Environment=NTFY_TOPIC=your-topic-here
ExecStart=/usr/local/bin/watch-approved.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
